diff --git a/modules/widgets/dashboard/controls/ModsPanel.qml b/modules/widgets/dashboard/controls/ModsPanel.qml
index 66cbd27d..07af71f2 100644
--- a/modules/widgets/dashboard/controls/ModsPanel.qml
+++ b/modules/widgets/dashboard/controls/ModsPanel.qml
@@ -30,6 +30,21 @@ Item {
     property string confirmSource: ""
     property var confirmMod: null
 
+    // Shared color-picker state: one popup serves every color setting row,
+    // keeping delegate instances cheap and avoiding layout children issues.
+    property string colorPickerKey: ""
+    property string colorPickerValue: "#000000"
+    property string colorPickerTitle: "Select Color"
+
+    function saveColorSetting(color) {
+        if (!root.selectedMod || root.colorPickerKey === "")
+            return;
+        const current = ModsService.settingsValues[root.colorPickerKey];
+        if (String(current ?? "") === String(color))
+            return;
+        ModsService.setSetting(root.selectedMod.id, root.colorPickerKey, color);
+    }
+
     // I18n is a native service now; the gate only survives as a safety
     // net in case the singleton fails to load.
     readonly property bool i18nActive: typeof I18n !== "undefined"
@@ -1167,6 +1182,18 @@ Item {
                                     ModsService.setSetting(root.selectedMod.id, settingRow.modelData.key, value);
                                 }
 
+                                // String fields carrying a color (explicit
+                                // `format: "color"`, or a hex-looking default until the
+                                // backend forwards `format`) get a picker swatch.
+                                readonly property bool isColorField: {
+                                    if (settingRow.modelData.type !== "string")
+                                        return false;
+                                    if ((settingRow.modelData.format ?? "") === "color")
+                                        return true;
+                                    const def = settingRow.modelData.default;
+                                    return typeof def === "string" && /^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$/.test(def);
+                                }
+
                                 RowLayout {
                                     Layout.fillWidth: true
                                     spacing: 8
@@ -1257,6 +1284,43 @@ Item {
                                         onAccepted: settingRow.saveTextValue(text)
                                     }
 
+                                    // Color swatch: opens the shared picker popup (hex input
+                                    // + native dialog). The text field stays for manual entry.
+                                    StyledRect {
+                                        visible: settingRow.isColorField
+                                        Layout.preferredWidth: 40
+                                        Layout.preferredHeight: 34
+                                        variant: colorMouseArea.containsMouse ? "focus" : "common"
+                                        radius: Styling.radius(-2)
+                                        enableShadow: false
+                                        Accessible.name: settingRow.modelData.label
+                                        Accessible.description: settingRow.modelData.description ?? ""
+
+                                        Rectangle {
+                                            anchors.fill: parent
+                                            anchors.margins: 5
+                                            radius: Styling.radius(-4)
+                                            color: Config.resolveColor(ModsService.settingsValues[settingRow.modelData.key]
+                                                ?? settingRow.modelData.default ?? "transparent")
+                                            border.color: Colors.outline
+                                            border.width: 1
+                                        }
+
+                                        MouseArea {
+                                            id: colorMouseArea
+                                            anchors.fill: parent
+                                            hoverEnabled: true
+                                            cursorShape: Qt.PointingHandCursor
+                                            onClicked: {
+                                                root.colorPickerKey = settingRow.modelData.key;
+                                                root.colorPickerValue = String(ModsService.settingsValues[settingRow.modelData.key]
+                                                    ?? settingRow.modelData.default ?? "#000000");
+                                                root.colorPickerTitle = settingRow.modelData.label ?? "Select Color";
+                                                colorPickerPopup.open();
+                                            }
+                                        }
+                                    }
+
                                     ActionButton {
                                         text: root.tr("common.save")
                                         enabled: !ModsService.busy && !ModsService.settingsBusy
@@ -1475,4 +1539,18 @@ Item {
             }
         }
     }
+
+    // One shared picker for every color setting row. Popup is not a layout
+    // item, so it lives here at panel scope instead of inside the delegate.
+    // Save on close: the popup emits colorSelected live while picking, so we
+    // commit once the popup goes away instead of spamming the backend.
+    ColorPickerPopup {
+        id: colorPickerPopup
+        colorNames: []
+        currentColor: root.colorPickerValue
+        dialogTitle: root.colorPickerTitle
+
+        onColorSelected: color => root.colorPickerValue = String(color)
+        onClosed: root.saveColorSetting(root.colorPickerValue)
+    }
 }
